# syntax=docker/dockerfile:1
# lea-keyproxy (the key forwarder, port 4400): built with the Go of image/Containerfile.
ARG GO_IMAGE=docker.io/library/golang:1.26.9@sha256:37cfcca63222ec499bec5e8ad7aad52dbf7529db36d5812b8eae2f0621aa92d6
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS keyproxy
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
COPY internal/providers/ internal/providers/
COPY internal/keyproxy/ internal/keyproxy/
COPY cmd/lea-keyproxy/ cmd/lea-keyproxy/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} GOFLAGS=-mod=readonly \
    go build -trimpath -ldflags "-s -w" -o /out/lea-keyproxy ./cmd/lea-keyproxy

FROM alpine:3.22
RUN apk add --no-cache squid socat openssl \
 && tpl=$(dirname "$(find /usr/share/squid/errors -name ERR_ACCESS_DENIED | head -n1)") \
 && mkdir -p /etc/squid/lea-errors /etc/lea \
 && cp "$tpl"/* /etc/squid/lea-errors/
COPY proxy/errors/ /etc/squid/lea-errors/
COPY proxy/render-squid-conf.sh proxy/sni-matches.sh proxy/entrypoint.sh /usr/local/bin/
COPY --from=keyproxy /out/lea-keyproxy /usr/local/bin/lea-keyproxy
COPY config/internal-hosts /etc/lea/internal-hosts
RUN chmod 0755 /usr/local/bin/render-squid-conf.sh /usr/local/bin/sni-matches.sh /usr/local/bin/entrypoint.sh
EXPOSE 3128 2222 4318 4400
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
