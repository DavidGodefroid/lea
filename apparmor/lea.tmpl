abi <abi/@ABI@>,
include <tunables/global>

# lea: docker-default with its /proc write denies, plus what lea's nested rootless Podman needs and
# docker-default refuses (#100): mount, umount, remount and pivot_root (crun and pasta set up a
# nested container's mounts and root, see image/seccomp/lea.json for the matching syscalls) and,
# on ABI 4.0 hosts, user namespace creation (rootless Podman). Writes stay allowed under /proc/<pid> (Podman
# writes the uid_map, gid_map and setgroups of its user namespace there, crun the oom_score_adj of a
# nested container) and under /proc/sys/kernel/shm*, as docker-default allows them.
profile lea flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
@USERNS@
  network,
  capability,
  file,
  mount,
  umount,
  remount,
  pivot_root,
  ptrace peer=lea,
  signal peer=lea,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=dockerd,
  unix,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
