FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git jq openssh-client ca-certificates \
 && apt-get clean \
 && pip install --no-cache-dir shellcheck-py==0.10.0.1 \
 && git clone --depth 1 --branch v1.11.1 https://github.com/bats-core/bats-core.git /opt/bats \
 && /opt/bats/install.sh /usr/local
WORKDIR /lea
