#!/bin/sh
# Fake curl: records argv, exits FAKE_CURL_RC. With -w (lea update resolving the latest release)
# it prints FAKE_CURL_EFFECTIVE. With -o FILE it copies $FAKE_CURL_DIR/<last part of the URL>
# into FILE (exit 22 when that file is missing). Otherwise it prints FAKE_CURL_BODY.
{ printf 'curl'; for a in "$@"; do printf ' [%s]' "$a"; done; printf '\n'; } >>"${FAKE_LOG:?}"
out='' url='' w=''
while [ $# -gt 0 ]; do
  case $1 in -o) out=$2; shift ;; -w) w=1; shift ;; -*) ;; *) url=$1 ;; esac
  shift
done
rc=${FAKE_CURL_RC:-0}
[ "$rc" -eq 0 ] || exit "$rc"
if [ -n "$w" ]; then printf '%s' "${FAKE_CURL_EFFECTIVE:-}"; exit 0; fi
if [ -n "$out" ] && [ "$out" != /dev/null ]; then
  [ -f "${FAKE_CURL_DIR:-/nonexistent}/${url##*/}" ] || exit 22
  cp "$FAKE_CURL_DIR/${url##*/}" "$out"
  exit 0
fi
if [ -n "${FAKE_CURL_BODY:-}" ]; then printf '%s\n' "$FAKE_CURL_BODY"; fi
