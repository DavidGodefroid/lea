#!/bin/sh
# locksql: the locksql console of your lea projects, in its own container (lea locksql). lea init
# links it into ~/.local/bin next to lea; locksql vault ARGS runs the vault CLI as the console
# account.
set -eu
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
exec "$(cd "$(dirname "$self")" && pwd -P)/lea" locksql "$@"
