#!/bin/sh
# One lea session: loads lea's git SSH key into the agent if there is one, then runs a shell / command with --shell, Codex with --codex, or Claude Code with lea's hook settings: with
# --claude (a deck agent, lea-agent run) and by default.
set -eu
key=/lea/state/ssh/id_ed25519
if [ -f "$key" ] && ! ssh-add -l >/dev/null 2>&1; then
  ssh-add "$key" || echo "lea: the lea SSH key is not loaded; run ssh-add $key" >&2
fi
if [ "${1:-}" = --shell ]; then
  shift
  if [ $# -gt 0 ]; then exec "$@"; fi
  exec bash -l
fi
# A Codex agent (lea-agent run --cli codex): lea's flags come with its arguments (MCP server,
# notify, sandbox: internal/providers); its state is ~/.codex, private to the projects dir.
if [ "${1:-}" = --codex ]; then
  shift
  exec codex "$@"
fi
# lea's Claude hooks (agent state, bus wake-up, approvals) and telemetry env come in through
# --settings: file-based managed settings are skipped whenever an organisation has
# server-managed settings.
settings=${LEA_CLAUDE_SETTINGS:-/usr/local/share/lea/claude-settings.json}
lea_settings() { [ -f "$settings" ] && printf '%s\n' "$settings"; }
# lea's own Claude plugin (its skills, /lea:control-tower) comes with the image and loads for
# this session only: nothing is installed in the user's Claude configuration.
plugin=${LEA_CLAUDE_PLUGIN:-/usr/local/share/lea/claude-plugin}
if [ "${1:-}" = --claude ]; then shift; fi
# A resumed session's transcript whose last line was cut (a crash, a killed container) is cut
# after its last valid line first, the file as it was kept beside it: Claude Code would glue its
# next record onto the cut line (#219). It never stops the resume.
lea=${LEA_BIN:-lea}
prev=
for a in "$@"; do
  case $prev in --resume | -r) "$lea" repair-transcript "$a" || true ;; esac
  case $a in --resume=?*) "$lea" repair-transcript "${a#--resume=}" || true ;; esac
  prev=$a
done
if [ -d "$plugin" ]; then set -- --plugin-dir "$plugin" "$@"; fi
if s=$(lea_settings); then set -- --settings "$s" "$@"; fi
exec claude "$@"
