#!/bin/sh
# The agents' CLIs (Claude Code, Codex) update themselves: the image pins the version lea's CI
# verified, and this keeps a newer release of each beside it in /lea/cli, which the next agent
# runs. The entrypoint starts `loop` as lea-cli (uid 10090), never as root nor as the developer:
# the agents' user cannot write /lea/cli, so no agent can hand the next one a CLI of its own
# making (one that would skip lea's managed hooks). An update never touches a running agent: each
# release goes to a directory of its own, checked (its --version) before the `current` link moves
# to it atomically, and a version some process still runs is never removed. Off with
# LEA_CLI_AUTOUPDATE=0 (lea.conf): the agents then run the image's CLIs.
#
#   lea-cli-update path claude|codex   the program an agent runs (lea-session)
#   lea-cli-update check [claude|codex] one check now (both by default)
#   lea-cli-update loop                 a check now, then every LEA_CLI_INTERVAL seconds
#   lea-cli-update status               the image's and the updated version of each CLI
set -u
D=${LEA_CLI_DIR:-/lea/cli}
pins=${LEA_CLI_PINS:-/usr/local/share/lea}
owner=${LEA_CLI_OWNER:-10090}
npm=${LEA_CLI_NPM:-npm}
interval=${LEA_CLI_INTERVAL:-21600}
proc=${LEA_CLI_PROC:-/proc}

pkg() { case $1 in claude) echo @anthropic-ai/claude-code ;; codex) echo @openai/codex ;; esac; }
pin() {
  case $1 in claude) f=$pins/claude-code-version ;; codex) f=$pins/codex-version ;; esac
  v=$(cat "$f" 2>/dev/null) && semver "$v" && echo "$v"
}
semver() { printf '%s\n' "$1" | grep -Eqx '[0-9]{1,6}\.[0-9]{1,6}\.[0-9]{1,6}'; }
# newer A B: A is a later release than B.
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]; }
log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"; }
# trusted P: lea-cli's own, written by no one else (a directory the agents could change is ignored).
trusted() {
  [ -d "$1" ] && [ ! -L "$1" ] && [ "$(stat -c %u "$1")" = "$owner" ] && [ -z "$(find "$1" -maxdepth 0 -perm /022)" ]
}
# current CLI: the updated version the agents run, if any and trusted.
current() {
  [ "${LEA_CLI_AUTOUPDATE:-1}" != 0 ] || return 1
  v=$(readlink "$D/$1/current" 2>/dev/null) && semver "$v" || return 1
  for p in "$D" "$D/$1" "$D/$1/$v"; do trusted "$p" || return 1; done
  [ -x "$D/$1/$v/bin/$1" ] || return 1
  p=$(pin "$1") || p=0.0.0
  newer "$v" "$p" || return 1
  echo "$v"
}

case ${1:-} in
  path)
    case ${2:-} in claude | codex) ;; *) echo "usage: lea-cli-update path claude|codex" >&2; exit 2 ;; esac
    # The version's own path, not the link: a later swap leaves this agent's program where it is.
    if v=$(current "$2"); then echo "$D/$2/$v/bin/$2"; else echo "$2"; fi
    exit 0
    ;;
  status)
    for c in claude codex; do
      p=$(pin "$c") || p=unknown
      if v=$(current "$c"); then
        printf '%s %s (updated; image %s)\n' "$c" "$v" "$p"
      else
        printf '%s %s (image)\n' "$c" "$p"
      fi
      if [ -f "$D/$c/checked" ]; then printf '  last check: %s\n' "$(head -n 1 "$D/$c/checked")"; fi
    done
    exit 0
    ;;
esac

# in_use DIR: a live process runs a program of DIR (its command line names it).
in_use() {
  for f in "$proc"/[0-9]*/cmdline; do
    tr '\0' ' ' <"$f" 2>/dev/null | grep -qF "$1/" && return 0
  done
  return 1
}

# update CLI: installs the latest release of CLI when it is newer than what the agents run.
update() {
  c=$1 name=$(pkg "$1")
  install -d -m 0755 "$D/$c" || return 1
  latest=$("$npm" view --cache "$D/.npm" "$name" version 2>/dev/null | tail -n 1)
  if ! semver "$latest"; then
    log "$c: no release version from the registry ('$latest')" | tee "$D/$c/checked"
    return 1
  fi
  have=$(current "$c") || have=$(pin "$c") || have=0.0.0
  if ! newer "$latest" "$have"; then
    log "$c $have is the latest" | tee "$D/$c/checked"
    return 0
  fi
  dst=$D/$c/$latest tmp=$D/$c/.new-$latest
  if [ ! -d "$dst" ]; then
    rm -rf "$tmp"
    if ! "$npm" install -g --prefix "$tmp" --cache "$D/.npm" --no-audit --no-fund --no-update-notifier "$name@$latest" >"$D/$c/install.log" 2>&1; then
      rm -rf "$tmp"
      log "$c $latest: npm install failed (see $D/$c/install.log)" | tee "$D/$c/checked"
      return 1
    fi
    got=$("$tmp/bin/$c" --version 2>/dev/null | head -n 1)
    # "2.1.323 (Claude Code)", "codex-cli 0.169.0": the version as a word of its own.
    if ! printf ' %s \n' "$got" | grep -qF " $latest "; then
      rm -rf "$tmp"
      log "$c $latest: the installed program reports '$got', kept $have" | tee "$D/$c/checked"
      return 1
    fi
    chmod -R go-w "$tmp"
    mv "$tmp" "$dst" || return 1
  fi
  ln -sfn "$latest" "$D/$c/.current" && mv -T "$D/$c/.current" "$D/$c/current" || return 1
  log "$c $have -> $latest (new agents run it)" | tee "$D/$c/checked"
  # Keep the version before it (an agent may still run it) and any other some process runs.
  prev=$have
  for d in "$D/$c"/*; do
    v=${d##*/}
    semver "$v" || continue
    [ "$v" = "$latest" ] || [ "$v" = "$prev" ] && continue
    in_use "$D/$c/$v" && continue
    rm -rf "${D:?}/$c/$v"
  done
}

check() {
  install -d -m 0755 "$D" || return 1
  # One check at a time (a manual check during the loop's).
  exec 9>"$D/.lock"
  flock -n 9 || { log "a check is already running"; return 0; }
  rc=0
  for c in "$@"; do update "$c" || rc=1; done
  rm -rf "$D/.npm"
  exec 9>&-
  return $rc
}

case ${1:-} in
  check)
    shift
    case ${1:-all} in claude | codex) check "$1" ;; all) check claude codex ;; *) echo "usage: lea-cli-update check [claude|codex]" >&2; exit 2 ;; esac
    ;;
  loop)
    case $interval in '' | *[!0-9]*) echo "lea-cli-update: LEA_CLI_INTERVAL must be seconds" >&2; exit 2 ;; esac
    [ "$interval" -ge 60 ] || interval=60
    while :; do
      check claude codex || true
      sleep "$interval"
    done
    ;;
  *)
    echo "usage: lea-cli-update path claude|codex | check [claude|codex] | loop | status" >&2
    exit 2
    ;;
esac
