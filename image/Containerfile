# syntax=docker/dockerfile:1
# Go for the agents: the toolchain of the target platform, and staticcheck and govulncheck cross-
# compiled on the build platform (no emulated go build in a multi-platform build).
ARG GO_IMAGE=docker.io/library/golang:1.26.9@sha256:37cfcca63222ec499bec5e8ad7aad52dbf7529db36d5812b8eae2f0621aa92d6
FROM ${GO_IMAGE} AS go
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS go-tools
ARG TARGETARCH
ARG STATICCHECK_VERSION=v0.8.1
ARG GOVULNCHECK_VERSION=v1.8.0
ENV CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} GOPATH=/tmp/gopath GOFLAGS=-trimpath
RUN go install "honnef.co/go/tools/cmd/staticcheck@${STATICCHECK_VERSION}" \
 && go install "golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}" \
 && mkdir /out \
 && find /tmp/gopath/bin -type f -exec mv -t /out {} +

FROM quay.io/podman/stable:v5.8.7-immutable
ARG TARGETARCH
ARG CLAUDE_CODE_VERSION=2.1.296
ARG CODEX_VERSION=0.163.0
ARG RTK_VERSION=0.36.0
ARG LEA_VERSION=dev
# The base image's "podman" user would own uid 1000: lea creates the developer's user at start instead.
RUN userdel -r podman \
 && sed -i '/^podman:/d' /etc/subuid /etc/subgid \
 && dnf -y install --setopt=install_weak_deps=False \
      nodejs npm git openssh-clients make jq procps-ng util-linux findutils which curl \
      python3 ripgrep podman-docker docker-compose kubernetes-client gh glab fuse-overlayfs passt abduco \
 && dnf clean all \
 && touch /etc/containers/nodocker \
 && git config --system credential.helper 'store --file=/lea/state/git/credentials' \
 && ln -s /usr/libexec/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" "@openai/codex@${CODEX_VERSION}" && npm cache clean --force
RUN case "$TARGETARCH" in \
      amd64) asset=rtk-x86_64-unknown-linux-musl.tar.gz ;; \
      arm64) asset=rtk-aarch64-unknown-linux-gnu.tar.gz ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && cd /tmp \
 && curl -fsSLO "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/${asset}" \
 && curl -fsSLO "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/checksums.txt" \
 && grep " ${asset}\$" checksums.txt | sha256sum -c - \
 && tar -xzf "$asset" -C /usr/local/bin rtk \
 && rm -f "$asset" checksums.txt
# locksql client of a console in its own container (the socket volume of lox up's lock on /run/locksql).
# The archive is pinned by its sha256 in the release's checksums.txt, whose Sigstore signature by
# locksql's release workflow at that tag was checked when the pin was set (config/lea.conf).
# The client reads the root-owned system.toml for the socket dir and refuses a socket not served by
# the uid of the local account "locksql" (10001). /run/locksql has the console image's owner and
# mode.
RUN useradd -r -u 10001 -U -M -s /sbin/nologin locksql \
 && install -d -m 0755 /etc/locksql \
 && printf '%s\n' 'service_user = "locksql"' 'client_group = "locksql-clients"' 'socket_dir   = "/run/locksql"' 'x11          = "refuse"' > /etc/locksql/system.toml \
 && chmod 0644 /etc/locksql/system.toml \
 && case "$TARGETARCH" in \
      amd64) sq=08f49155e4f703a14518d0bb6d57959b095e72335187b2fbbeb1da7b8c707cd9 ;; \
      arm64) sq=5717fd94770e8e548859fd9e310e9b4e99514df941552c0dc8b9521ba9b24238 ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && cd /tmp && V=0.13.0 && A="locksql_${V}_linux_${TARGETARCH}.tar.gz" \
 && curl -fsSLO "https://github.com/DavidGodefroid/locksql/releases/download/v$V/$A" \
 && echo "$sq  $A" | sha256sum -c \
 && tar -xzf "$A" locksql && install -m 0755 -o root -g root locksql /usr/local/bin/locksql \
 && rm -f locksql "$A"
# lockmq and lockfile clients of a console in its own container (the socket volume of lox up's
# lock of the tool on /run/<tool>, read-only). As for locksql, the accounts of
# the tools' images are named here with their ids (lockmq 10011 and lockmq-clients 10010,
# lockfile 10031 and lockfile-clients 10030), the root-owned system.toml names them, and
# /run/<tool> has the console image's owner and mode, so an empty volume first mounted here is
# initialised as the console expects. The archives are pinned by the sha256
# of their release's checksums.txt, whose Sigstore signature by the tool's release workflow was
# checked when the pin was set; they match LEA_LOCKMQ_REF and LEA_LOCKFILE_REF (config/lea.conf).
RUN case "$TARGETARCH" in \
      amd64) mq=e02bb32043a2b62500912396dee01ea5c9cdd7e357e0002f94f984cb85f51332 lf=911695a7a439fe84a20e8977b2d4e757bdea929c7508d8473d019d5d4bbd4a35 ;; \
      arm64) mq=6f5bc3a451f8a595584fe43f323e9df41b460c66461df9576fad5839892e6af0 lf=755d1f327d54a7b6733bf091dee4f337bd8018488db6f605185e3f1c7442fe4c ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && cd /tmp && MQ=0.6.0 LF=0.6.0 \
 && curl -fsSLO "https://github.com/DavidGodefroid/lockmq/releases/download/v$MQ/lockmq_${MQ}_linux_${TARGETARCH}.tar.gz" \
 && echo "$mq  lockmq_${MQ}_linux_${TARGETARCH}.tar.gz" | sha256sum -c \
 && curl -fsSLO "https://github.com/DavidGodefroid/lockfile/releases/download/v$LF/lockfile_${LF}_linux_${TARGETARCH}.tar.gz" \
 && echo "$lf  lockfile_${LF}_linux_${TARGETARCH}.tar.gz" | sha256sum -c \
 && tar -xzf "lockmq_${MQ}_linux_${TARGETARCH}.tar.gz" lockmq && tar -xzf "lockfile_${LF}_linux_${TARGETARCH}.tar.gz" lockfile \
 && install -m 0755 -o root -g root lockmq lockfile /usr/local/bin/ \
 && rm -f lockmq lockfile ./*.tar.gz \
 && groupadd -g 10010 lockmq-clients && useradd -r -u 10011 -U -M -s /sbin/nologin lockmq \
 && groupadd -g 10030 lockfile-clients && useradd -r -u 10031 -U -M -s /sbin/nologin lockfile \
 && for t in lockmq lockfile; do \
      install -d -m 0755 -o root -g root /etc/$t \
      && printf '%s\n' "service_user = \"$t\"" "client_group = \"$t-clients\"" "socket_dir   = \"/run/$t\"" 'x11          = "refuse"' > /etc/$t/system.toml \
      && chmod 0644 /etc/$t/system.toml; \
    done \
 && install -d -m 2710 -o 10011 -g 10010 /run/lockmq \
 && install -d -m 2750 -o 10031 -g 10030 /run/lockfile
RUN groupadd -g 10000 locksql-clients \
 && install -d -m 2710 -o 10001 -g 10000 /run/locksql \
 && install -d -m 0755 /lea /lea/podman /usr/local/share/lea /usr/local/libexec/lea /etc/claude-code
COPY image/containers.conf.tmpl /usr/local/share/lea/containers.conf.tmpl
COPY image/storage.conf /etc/containers/storage.conf
COPY image/ssh_config.tmpl /usr/local/share/lea/ssh_config.tmpl
COPY image/managed-settings.json /etc/claude-code/managed-settings.json
COPY image/claude-settings.json /usr/local/share/lea/claude-settings.json
COPY image/claude-plugin /usr/local/share/lea/claude-plugin
COPY image/entrypoint image/user-init /usr/local/libexec/lea/
COPY image/lea-crun /usr/local/libexec/lea/
COPY image/lea-session image/lea-agent image/wl-copy /usr/local/bin/
COPY image/go-cross /usr/local/bin/
COPY --from=go /usr/local/go /usr/local/go
COPY --from=go-tools /out/ /usr/local/bin/
RUN sed -i "s/@LEA_VERSION@/${LEA_VERSION}/" /etc/claude-code/managed-settings.json /usr/local/share/lea/claude-settings.json \
 && chmod 0644 /etc/claude-code/managed-settings.json /usr/local/share/lea/claude-settings.json \
 && chmod -R u=rwX,go=rX /usr/local/share/lea/claude-plugin \
 && chmod 0755 /usr/local/libexec/lea/entrypoint /usr/local/libexec/lea/user-init /usr/local/libexec/lea/lea-crun /usr/local/bin/lea-session /usr/local/bin/lea-agent /usr/local/bin/wl-copy /usr/local/bin/go-cross
# Go's caches and installed tools live in the persistent state dir go (/lea/state/go); the
# toolchain never downloads another one (GOTOOLCHAIN=local).
ENV PATH=/usr/local/go/bin:/lea/state/go/bin:$PATH \
    GOTOOLCHAIN=local \
    GOPATH=/lea/state/go \
    GOCACHE=/lea/state/go/cache \
    GOFLAGS=-modcacherw
ENV SSH_AUTH_SOCK=/run/lea/ssh-agent.sock \
    GH_CONFIG_DIR=/lea/state/gh \
    GLAB_CONFIG_DIR=/lea/state/glab-cli \
    REGISTRY_AUTH_FILE=/lea/state/containers/auth.json
# The base image builds with chroot isolation, which remounts /dev read-only: lea's container may
# not, so every RUN step of a docker build failed. Rootless isolation runs it in its own namespaces.
ENV BUILDAH_ISOLATION=rootless
ENTRYPOINT ["/usr/local/libexec/lea/entrypoint"]
