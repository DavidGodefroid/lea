# syntax=docker/dockerfile:1
# Go for the agents: the toolchain of the target platform, and staticcheck and govulncheck cross-
# compiled on the build platform (no emulated go build in a multi-platform build).
ARG GO_IMAGE=docker.io/library/golang:1.26.9@sha256:37cfcca63222ec499bec5e8ad7aad52dbf7529db36d5812b8eae2f0621aa92d6
FROM ${GO_IMAGE} AS go
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS go-tools
ARG TARGETARCH
ARG STATICCHECK_VERSION=v0.8.1
ARG GOVULNCHECK_VERSION=v1.8.0
ENV CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} GOPATH=/tmp/gopath GOFLAGS=-trimpath
RUN go install "honnef.co/go/tools/cmd/staticcheck@${STATICCHECK_VERSION}" \
 && go install "golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}" \
 && mkdir /out \
 && find /tmp/gopath/bin -type f -exec mv -t /out {} +

FROM quay.io/podman/stable:v5.8.7-immutable
ARG TARGETARCH
ARG CLAUDE_CODE_VERSION=2.1.296
ARG CODEX_VERSION=0.163.0
ARG RTK_VERSION=0.36.0
ARG LEA_VERSION=dev
# The base image's "podman" user would own uid 1000: lea creates the developer's user at start instead.
RUN userdel -r podman \
 && sed -i '/^podman:/d' /etc/subuid /etc/subgid \
 && dnf -y install --setopt=install_weak_deps=False \
      nodejs npm git openssh-clients make jq procps-ng util-linux findutils which curl \
      python3 ripgrep podman-docker docker-compose kubernetes-client gh glab fuse-overlayfs passt abduco \
 && dnf clean all \
 && touch /etc/containers/nodocker \
 && git config --system credential.helper 'store --file=/lea/state/git/credentials' \
 && git config --system url.http://lea-proxy:4401/.insteadOf https://github.com/ \
 && ln -s /usr/libexec/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" "@openai/codex@${CODEX_VERSION}" && npm cache clean --force
RUN case "$TARGETARCH" in \
      amd64) asset=rtk-x86_64-unknown-linux-musl.tar.gz ;; \
      arm64) asset=rtk-aarch64-unknown-linux-gnu.tar.gz ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && cd /tmp \
 && curl -fsSLO "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/${asset}" \
 && curl -fsSLO "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/checksums.txt" \
 && grep " ${asset}\$" checksums.txt | sha256sum -c - \
 && tar -xzf "$asset" -C /usr/local/bin rtk \
 && rm -f "$asset" checksums.txt
# The Locks' clients (locksql, lockmq, lockfile, locklog) of consoles in their own containers (the socket
# volume of each lock lox runs, on /run/<lock>, read-only), from one set of releases:
# config/locks.lock (lea#134), which lea's CI bumps as a whole. Each archive is pinned by its
# sha256 in its release's checksums.txt, whose Sigstore signature by the Lock's release workflow at
# that tag was checked when the set was bumped (tools/locks-bump). The set ships in the image too.
# Each client reads its root-owned system.toml for the socket dir and refuses a socket not served
# by the uid of its console account; the accounts and clients groups have the ids of the Locks'
# own images (locksql 10001 and locksql-clients 10000, lockmq 10011 and lockmq-clients 10010,
# lockfile 10031 and lockfile-clients 10030, locklog 10051 and locklog-clients 10050), and /run/<lock> the console image's owner and mode,
# so an empty volume first mounted here is initialised as the console expects.
COPY config/locks.lock /usr/local/share/lea/locks.lock
RUN case "$TARGETARCH" in \
      amd64) A=AMD64 ;; \
      arm64) A=ARM64 ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && cd /tmp \
 && for t in locksql lockmq lockfile locklog; do \
      T=$(echo "$t" | tr a-z A-Z) \
      && v=$(sed -n "s/^LOCKS_${T}_VERSION=v\([0-9][0-9.]*\)\$/\1/p" /usr/local/share/lea/locks.lock) \
      && sum=$(sed -n "s/^LOCKS_${T}_SHA256_${A}=\([0-9a-f]\{64\}\)\$/\1/p" /usr/local/share/lea/locks.lock) \
      && [ -n "$v" ] && [ -n "$sum" ] \
      && a="${t}_${v}_linux_${TARGETARCH}.tar.gz" \
      && curl -fsSLO "https://github.com/DavidGodefroid/$t/releases/download/v$v/$a" \
      && echo "$sum  $a" | sha256sum -c \
      && tar -xzf "$a" "$t" && install -m 0755 -o root -g root "$t" /usr/local/bin/ \
      && rm -f "$t" "$a" || exit 1; \
    done \
 && chmod 0644 /usr/local/share/lea/locks.lock \
 && useradd -r -u 10001 -U -M -s /sbin/nologin locksql \
 && groupadd -g 10010 lockmq-clients && useradd -r -u 10011 -U -M -s /sbin/nologin lockmq \
 && groupadd -g 10030 lockfile-clients && useradd -r -u 10031 -U -M -s /sbin/nologin lockfile \
 && groupadd -g 10050 locklog-clients && useradd -r -u 10051 -U -M -s /sbin/nologin locklog \
 && for t in locksql lockmq lockfile locklog; do \
      install -d -m 0755 -o root -g root /etc/$t \
      && printf '%s\n' "service_user = \"$t\"" "client_group = \"$t-clients\"" "socket_dir   = \"/run/$t\"" 'x11          = "refuse"' > /etc/$t/system.toml \
      && chmod 0644 /etc/$t/system.toml; \
    done \
 && install -d -m 2710 -o 10011 -g 10010 /run/lockmq \
 && install -d -m 2750 -o 10031 -g 10030 /run/lockfile \
 && install -d -m 2750 -o 10051 -g 10050 /run/locklog
RUN groupadd -g 10000 locksql-clients \
 && install -d -m 2710 -o 10001 -g 10000 /run/locksql \
 && install -d -m 0755 /lea /lea/podman /usr/local/share/lea /usr/local/libexec/lea /etc/claude-code
COPY image/containers.conf.tmpl /usr/local/share/lea/containers.conf.tmpl
COPY image/storage.conf /etc/containers/storage.conf
COPY image/ssh_config.tmpl /usr/local/share/lea/ssh_config.tmpl
COPY image/managed-settings.json /etc/claude-code/managed-settings.json
# The entrypoint starts each boot from this copy, adding the host's permission rules (#111).
COPY image/managed-settings.json /usr/local/share/lea/managed-settings.json
COPY image/claude-settings.json /usr/local/share/lea/claude-settings.json
COPY image/claude-plugin /usr/local/share/lea/claude-plugin
COPY image/forge-gh/config.yml /usr/local/share/lea/forge-gh/config.yml
COPY image/entrypoint image/user-init /usr/local/libexec/lea/
COPY image/lea-crun image/managed-check /usr/local/libexec/lea/
COPY image/lea-session image/lea-agent image/wl-copy /usr/local/bin/
COPY image/go-cross /usr/local/bin/
COPY --from=go /usr/local/go /usr/local/go
COPY --from=go-tools /out/ /usr/local/bin/
# The Claude Code version lea's CI verified the managed settings with (managed-check).
RUN sed -i "s/@LEA_VERSION@/${LEA_VERSION}/" /etc/claude-code/managed-settings.json /usr/local/share/lea/managed-settings.json /usr/local/share/lea/claude-settings.json \
 && echo "${CLAUDE_CODE_VERSION}" >/usr/local/share/lea/claude-code-version \
 && chmod 0644 /etc/claude-code/managed-settings.json /usr/local/share/lea/managed-settings.json /usr/local/share/lea/claude-settings.json /usr/local/share/lea/claude-code-version \
 && chmod -R u=rwX,go=rX /usr/local/share/lea/claude-plugin /usr/local/share/lea/forge-gh \
 && chmod 0755 /usr/local/libexec/lea/entrypoint /usr/local/libexec/lea/user-init /usr/local/libexec/lea/lea-crun /usr/local/libexec/lea/managed-check /usr/local/bin/lea-session /usr/local/bin/lea-agent /usr/local/bin/wl-copy /usr/local/bin/go-cross
# No way back to root once the entrypoint has dropped to the developer (#100): sudo is not in the
# image and no file is setuid or setgid. newuidmap and newgidmap keep their file capabilities
# (cap_setuid, cap_setgid): the rootless Podman maps its sub-ids with them, which is also why lea
# cannot run with no-new-privileges.
# dnf protects sudo (/etc/dnf/protected.d): rpm removes it, nothing requires it.
RUN rpm -e sudo \
 && rm -f /etc/dnf/protected.d/sudo.conf \
 && find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod ug-s {} + \
 && [ -z "$(find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -print -quit)" ]
# Go's caches and installed tools live in the persistent state dir go (/lea/state/go); the
# toolchain never downloads another one (GOTOOLCHAIN=local).
ENV PATH=/usr/local/go/bin:/lea/state/go/bin:$PATH \
    GOTOOLCHAIN=local \
    GOPATH=/lea/state/go \
    GOCACHE=/lea/state/go/cache \
    GOFLAGS=-modcacherw
# GitHub (issue #103): the token is in the proxy only. git reaches github.com through the proxy's
# forge forwarder (url.insteadOf above), gh through the relay's socket (http_unix_socket, set in
# the agents' gh config at start); GH_TOKEN is a placeholder the forwarder replaces, so that gh
# counts as logged in.
ENV SSH_AUTH_SOCK=/run/lea/ssh-agent.sock \
    GH_TOKEN=lea-proxy-adds-the-token \
    GH_CONFIG_DIR=/lea/state/gh \
    GLAB_CONFIG_DIR=/lea/state/glab-cli \
    REGISTRY_AUTH_FILE=/lea/state/containers/auth.json
# The base image builds with chroot isolation, which remounts /dev read-only: lea's container may
# not, so every RUN step of a docker build failed. Rootless isolation runs it in its own namespaces.
ENV BUILDAH_ISOLATION=rootless
ENTRYPOINT ["/usr/local/libexec/lea/entrypoint"]
