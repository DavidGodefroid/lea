#!/bin/sh
# lea root entrypoint: creates the host user, sub-ids and runtime dirs, then drops privileges.
set -eu
: "${LEA_UID:?}" "${LEA_GID:?}" "${LEA_USER:?}" "${HOME:?}" "${LEA_PROXY_IP:?}"
for ep in ${LEA_GIT_SSH:-}; do
  case ${ep%%:*} in ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.-]*)
    echo "lea: invalid LEA_GIT_SSH endpoint" >&2; exit 1 ;;
  esac
done
[ "$LEA_UID" -ne 0 ] || { echo "lea: refusing to run the session as root" >&2; exit 1; }
[ "$LEA_GID" -ne 0 ] || { echo "lea: refusing to run the session with group root" >&2; exit 1; }
# The ids of the locks' accounts and clients groups in the image (locksql, lockmq, lockfile): a
# session with one of them would be that console account, or in that group without asking.
for id in 10000 10001 10010 10011 10030 10031; do
  if [ "$LEA_UID" -eq "$id" ] || [ "$LEA_GID" -eq "$id" ]; then
    echo "lea: refusing to run the session as uid $LEA_UID / gid $LEA_GID: a lock console's id in lea's image" >&2; exit 1
  fi
done
# A name useradd accepts everywhere: ^[a-z_][a-z0-9_-]*$, at most 32 characters.
case $LEA_USER in [abcdefghijklmnopqrstuvwxyz_]*) ;; *) LEA_USER=u$LEA_UID ;; esac
case $LEA_USER in *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) LEA_USER=u$LEA_UID ;; esac
[ "${#LEA_USER}" -le 32 ] || LEA_USER=u$LEA_UID

getent group "$LEA_GID" >/dev/null || groupadd -g "$LEA_GID" "$LEA_USER"
if ! getent passwd "$LEA_UID" >/dev/null; then
  useradd -M -N -d "$HOME" -u "$LEA_UID" -g "$LEA_GID" -s /bin/bash "$LEA_USER"
fi
user=$(getent passwd "$LEA_UID" | cut -d: -f1)
# The clients groups of the locks lea is wired for (their consoles run in their own containers).
if [ "${LEA_LOCKSQL:-0}" = 1 ]; then usermod -aG locksql-clients "$user"; fi
if [ "${LEA_LOCKMQ:-0}" = 1 ]; then usermod -aG lockmq-clients "$user"; fi
if [ "${LEA_LOCKFILE:-0}" = 1 ]; then usermod -aG lockfile-clients "$user"; fi
grep -q "^$user:" /etc/subuid || echo "$user:200000:65536" >>/etc/subuid
grep -q "^$user:" /etc/subgid || echo "$user:200000:65536" >>/etc/subgid

# Runtime state of a previous boot: /run is the container's writable layer, so a docker start
# after a host crash or reboot finds it again. Podman refuses to run on its stale boot ID (#97),
# a stale socket would pass for the new service's, and agent and shell pid files name dead
# processes. The bus directory (/run/lea/bus) is a bind mount and stays.
rm -rf "/run/user/$LEA_UID" /run/lea/agents /run/lea/shells /run/lea/ready
install -d -m 0700 -o "$LEA_UID" -g "$LEA_GID" "/run/user/$LEA_UID"
install -d -m 0755 -o "$LEA_UID" -g "$LEA_GID" /run/lea
chown "$LEA_UID:$LEA_GID" /lea/podman
# Go's state (GOPATH, GOCACHE): the bind mount of the state dir go, or a dir of this container
# when the launcher does not mount it.
[ -d /lea/state/go ] || install -d -o "$LEA_UID" -g "$LEA_GID" /lea/state/go
install -d -o "$LEA_UID" -g "$LEA_GID" "$HOME"
for d in "$HOME/.config" "$HOME/.kube"; do
  if [ -d "$d" ]; then chown "$LEA_UID:$LEA_GID" "$d"; fi
done

case $LEA_PROXY_IP in ''|*[!0123456789.]*) echo "lea: invalid LEA_PROXY_IP" >&2; exit 1 ;; esac
nested_proxy=http://$LEA_PROXY_IP:3128
if [ "${LEA_LOCKHTTP:-0}" = 1 ]; then
  # LockHTTP: the nested Podman's containers go through the gate as "nested".
  case ${LEA_NESTED_PROXY_TOKEN:-} in ''|*[!0123456789abcdef]*)
    echo "lea: LEA_LOCKHTTP=1 needs LEA_NESTED_PROXY_TOKEN (lea's launcher sets it)" >&2; exit 1 ;;
  esac
  nested_proxy=http://nested:$LEA_NESTED_PROXY_TOKEN@$LEA_PROXY_IP:3130
fi
sed -e "s|@LEA_NESTED_PROXY@|$nested_proxy|g" /usr/local/share/lea/containers.conf.tmpl >/etc/containers/containers.conf
# Under gVisor (LEA_RUNTIME=runsc, #106) the nested Podman cannot give a container a network
# namespace of its own: it keeps one by bind-mounting its nsfs file, which gVisor refuses (EINVAL).
# Its containers share lea's network namespace instead (still behind lea's proxy and internal
# network); their ports then share lea's (README, "A second kernel: gVisor or Kata").
case $(uname -r) in *gvisor*)
  sed -i 's|^utsns = "host"$|&\n# gVisor (written by the entrypoint): no network namespace of their own.\nnetns = "host"|' /etc/containers/containers.conf ;;
esac
if [ "${LEA_LOCKHTTP_MITM:-0}" = 1 ]; then
  # The LockHTTP gate decrypts HTTPS with lea's local CA: its certificate (never its key) joins
  # the system trust store, which curl, git, Go, OpenSSL and Podman read; the launcher points
  # Node, Python requests and pip at it too.
  [ -s /etc/lea/lockhttp-ca.pem ] || { echo "lea: LEA_LOCKHTTP_MITM=1 needs /etc/lea/lockhttp-ca.pem (lea's launcher mounts it)" >&2; exit 1; }
  install -m 0644 /etc/lea/lockhttp-ca.pem /etc/pki/ca-trust/source/anchors/lea-lockhttp.pem
  update-ca-trust extract
fi
# The permission rules are the managed settings' only (allowManagedPermissionRulesOnly, #111):
# an agent's own ~/.claude/settings.json or a project's .claude/settings*.json cannot widen them.
# The host's own rules join lea's here, from the host's ~/.claude/settings.json as the launcher
# read it (read-only, never the container's copy): strings only, and a default mode other than
# bypassPermissions. Each start begins again from the image's file (a restart adds nothing twice);
# a file jq cannot merge leaves lea's rules alone.
m=/etc/claude-code/managed-settings.json
mb=/usr/local/share/lea/managed-settings.json
hp=/etc/lea/claude-permissions.json
[ ! -f "$mb" ] || cp "$mb" "$m"
if [ -f "$hp" ] && [ ! -L "$hp" ]; then
  if jq --slurpfile h "$hp" '
      def strs: if type == "array" then map(select(type == "string" and length > 0 and length <= 1024))[:1000] else [] end;
      (if ($h[0] | type) == "object" then $h[0] else {} end) as $p
      | .permissions.allow = ((.permissions.allow // []) + ($p.allow | strs))
      | .permissions.ask = ((.permissions.ask // []) + ($p.ask | strs))
      | .permissions.deny = ((.permissions.deny // []) + ($p.deny | strs))
      | .permissions.additionalDirectories = ((.permissions.additionalDirectories // []) + ($p.additionalDirectories | strs))
      | if ["default", "acceptEdits", "plan", "dontAsk", "auto"] | index([$p.defaultMode]) then .permissions.defaultMode = $p.defaultMode else . end
      | .allowManagedPermissionRulesOnly = true
      | .permissions.disableBypassPermissionsMode = "disable"' "$m" >"$m.new"; then
    chmod 0644 "$m.new"
    mv "$m.new" "$m"
  else
    rm -f "$m.new"
    echo "lea: $hp: the host's permission rules could not be read; lea's own apply" >&2
  fi
fi
if [ "${LEA_LOCKHTTP:-0}" = 1 ]; then
  # LockHTTP decides every request the agents make; claude.ai's connectors would act from
  # Anthropic's side, out of its sight: off (decision D10; WebSearch and WebFetch stay).
  m=/etc/claude-code/managed-settings.json
  jq '.env.ENABLE_CLAUDEAI_MCP_SERVERS = "false"' "$m" >"$m.new"
  chmod 0644 "$m.new"
  mv "$m.new" "$m"
fi
# lea's managed settings (its hooks, #111) are root's: the agents' user can rewrite its own
# ~/.claude/settings.json, never these, and no drop-in directory may add to them.
chown -R 0:0 /etc/claude-code
chmod 0755 /etc/claude-code
chmod 0644 /etc/claude-code/managed-settings.json
rm -rf /etc/claude-code/managed-settings.d
# Each git SSH endpoint goes to its forwarder on the proxy (port 2222 + its index), by IP so that
# nested containers (GIT_SSH_COMMAND -F /run/lea/ssh_config) reach it too.
{
  echo "# git SSH endpoints of LEA_GIT_SSH, through the lea-proxy forwarders (written at start)."
  port=2222
  for ep in ${LEA_GIT_SSH:-}; do
    printf 'Host %s\n  HostName %s\n  Port %s\n  HostKeyAlias %s\n  UserKnownHostsFile /run/lea/known_hosts\n  StrictHostKeyChecking yes\n  IdentityAgent /run/lea/ssh-agent.sock\n' \
      "${ep%%:*}" "$LEA_PROXY_IP" "$port" "${ep%%:*}"
    port=$((port + 1))
  done
} >/run/lea/ssh_config
chmod 0644 /run/lea/ssh_config
install -m 0644 /usr/local/share/lea/ssh_config.tmpl /etc/ssh/ssh_config.d/10-lea.conf
if [ -f /lea/state/ssh/known_hosts ]; then install -m 0644 /lea/state/ssh/known_hosts /run/lea/known_hosts; fi

# The GitHub relay (issue #103): gh's requests (http_unix_socket) go to the proxy's forge
# forwarder, which holds the token. It runs as nobody in a directory of nobody's: the developer's
# processes connect, but cannot replace the socket or stop the relay.
install -d -m 0755 -o 65534 -g 65534 /run/lea-forge
if [ -x /usr/local/bin/lea ]; then
  setpriv --reuid 65534 --regid 65534 --clear-groups --no-new-privs \
    /usr/local/bin/lea forge-relay /run/lea-forge/gh.sock "$LEA_PROXY_IP:4401" </dev/null &
fi

exec setpriv --reuid "$LEA_UID" --regid "$LEA_GID" --init-groups /usr/local/libexec/lea/user-init
