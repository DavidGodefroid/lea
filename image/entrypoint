#!/bin/sh
# lea root entrypoint: creates the host user, sub-ids and runtime dirs, then drops privileges.
set -eu
: "${LEA_UID:?}" "${LEA_GID:?}" "${LEA_USER:?}" "${HOME:?}" "${LEA_PROXY_IP:?}"
for ep in ${LEA_GIT_SSH:-}; do
  case ${ep%%:*} in ''|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.-]*)
    echo "lea: invalid LEA_GIT_SSH endpoint" >&2; exit 1 ;;
  esac
done
[ "$LEA_UID" -ne 0 ] || { echo "lea: refusing to run the session as root" >&2; exit 1; }
[ "$LEA_GID" -ne 0 ] || { echo "lea: refusing to run the session with group root" >&2; exit 1; }
# A name useradd accepts everywhere: ^[a-z_][a-z0-9_-]*$, at most 32 characters.
case $LEA_USER in [abcdefghijklmnopqrstuvwxyz_]*) ;; *) LEA_USER=u$LEA_UID ;; esac
case $LEA_USER in *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) LEA_USER=u$LEA_UID ;; esac
[ "${#LEA_USER}" -le 32 ] || LEA_USER=u$LEA_UID

getent group "$LEA_GID" >/dev/null || groupadd -g "$LEA_GID" "$LEA_USER"
if ! getent passwd "$LEA_UID" >/dev/null; then
  useradd -M -N -d "$HOME" -u "$LEA_UID" -g "$LEA_GID" -s /bin/bash "$LEA_USER"
fi
user=$(getent passwd "$LEA_UID" | cut -d: -f1)
if [ "${LEA_LOCKSQL:-0}" = 1 ]; then usermod -aG locksql-clients "$user"; fi
# shellcheck source=image/lock-host
. /usr/local/libexec/lea/lock-host
if [ "${LEA_LOCKMQ:-0}" = 1 ]; then lock_host lockmq "${LEA_LOCKMQ_UID:-}" "${LEA_LOCKMQ_GID:-}"; fi
if [ "${LEA_LOCKFILE:-0}" = 1 ]; then lock_host lockfile "${LEA_LOCKFILE_UID:-}" "${LEA_LOCKFILE_GID:-}"; fi
grep -q "^$user:" /etc/subuid || echo "$user:200000:65536" >>/etc/subuid
grep -q "^$user:" /etc/subgid || echo "$user:200000:65536" >>/etc/subgid

# Runtime state of a previous boot: /run is the container's writable layer, so a docker start
# after a host crash or reboot finds it again. Podman refuses to run on its stale boot ID (#97),
# a stale socket would pass for the new service's, and agent and shell pid files name dead
# processes. The bus directory (/run/lea/bus) is a bind mount and stays.
rm -rf "/run/user/$LEA_UID" /run/lea/agents /run/lea/shells /run/lea/ready
install -d -m 0700 -o "$LEA_UID" -g "$LEA_GID" "/run/user/$LEA_UID"
install -d -m 0755 -o "$LEA_UID" -g "$LEA_GID" /run/lea
chown "$LEA_UID:$LEA_GID" /lea/podman
# Go's state (GOPATH, GOCACHE): the bind mount of the state dir go, or a dir of this container
# when the launcher does not mount it.
[ -d /lea/state/go ] || install -d -o "$LEA_UID" -g "$LEA_GID" /lea/state/go
install -d -o "$LEA_UID" -g "$LEA_GID" "$HOME"
for d in "$HOME/.config" "$HOME/.kube"; do
  if [ -d "$d" ]; then chown "$LEA_UID:$LEA_GID" "$d"; fi
done

case $LEA_PROXY_IP in ''|*[!0123456789.]*) echo "lea: invalid LEA_PROXY_IP" >&2; exit 1 ;; esac
nested_proxy=http://$LEA_PROXY_IP:3128
if [ "${LEA_LOCKHTTP:-0}" = 1 ]; then
  # LockHTTP: the nested Podman's containers go through the gate as "nested".
  case ${LEA_NESTED_PROXY_TOKEN:-} in ''|*[!0123456789abcdef]*)
    echo "lea: LEA_LOCKHTTP=1 needs LEA_NESTED_PROXY_TOKEN (lea's launcher sets it)" >&2; exit 1 ;;
  esac
  nested_proxy=http://nested:$LEA_NESTED_PROXY_TOKEN@$LEA_PROXY_IP:3130
fi
sed -e "s|@LEA_NESTED_PROXY@|$nested_proxy|g" /usr/local/share/lea/containers.conf.tmpl >/etc/containers/containers.conf
if [ "${LEA_LOCKHTTP:-0}" = 1 ]; then
  # LockHTTP decides every request the agents make; claude.ai's connectors would act from
  # Anthropic's side, out of its sight: off (decision D10; WebSearch and WebFetch stay).
  m=/etc/claude-code/managed-settings.json
  jq '.env.ENABLE_CLAUDEAI_MCP_SERVERS = "false"' "$m" >"$m.new"
  chmod 0644 "$m.new"
  mv "$m.new" "$m"
fi
# Each git SSH endpoint goes to its forwarder on the proxy (port 2222 + its index), by IP so that
# nested containers (GIT_SSH_COMMAND -F /run/lea/ssh_config) reach it too.
{
  echo "# git SSH endpoints of LEA_GIT_SSH, through the lea-proxy forwarders (written at start)."
  port=2222
  for ep in ${LEA_GIT_SSH:-}; do
    printf 'Host %s\n  HostName %s\n  Port %s\n  HostKeyAlias %s\n  UserKnownHostsFile /run/lea/known_hosts\n  StrictHostKeyChecking yes\n  IdentityAgent /run/lea/ssh-agent.sock\n' \
      "${ep%%:*}" "$LEA_PROXY_IP" "$port" "${ep%%:*}"
    port=$((port + 1))
  done
} >/run/lea/ssh_config
chmod 0644 /run/lea/ssh_config
install -m 0644 /usr/local/share/lea/ssh_config.tmpl /etc/ssh/ssh_config.d/10-lea.conf
if [ -f /lea/state/ssh/known_hosts ]; then install -m 0644 /lea/state/ssh/known_hosts /run/lea/known_hosts; fi

exec setpriv --reuid "$LEA_UID" --regid "$LEA_GID" --init-groups /usr/local/libexec/lea/user-init
