#!/bin/sh
# Deck agents inside lea. `run` is what abduco starts for an agent: it records the agent's pid,
# then becomes its CLI (Claude Code, or Codex with --cli codex) through lea-session (exec keeps the pid). `ls` prints the live agents;
# `stop` ends one; `pause` freezes one with its children and the containers it started (SIGSTOP),
# `resume` lets them continue (SIGCONT). Each agent gets a CPU window (LEA_AGENT_CPUS, #132) and its own Podman service: what it starts in the nested Podman carries
# the annotation lea.agent=NAME, `teardown` removes it when the agent ends, `park` stops it while
# the agent is idle (#132), and `sweep` removes the stacks of agents that are gone (#97). The deck's shells (s) work the same way: `shell` is what abduco starts for one (the
# user's login shell, never an agent: no LEA_AGENT), `shells` prints the live ones and
# `stop-shell` ends one. The host reaches this script only through `docker exec`.
set -eu
dir=${LEA_AGENT_RUN_DIR:-/run/lea/agents}
shell_dir=${LEA_SHELL_RUN_DIR:-/run/lea/shells}
wait_s=${LEA_AGENT_STOP_WAIT:-5}
# park watches the stack's CPU that long (seconds) first: a stack still at work is not stopped.
park_sample=${LEA_AGENT_PARK_SAMPLE:-2}
podman=${LEA_AGENT_PODMAN:-podman}
podman_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman

valid() {
  case $1 in [abcdefghijklmnopqrstuvwxyz]*) ;; *) return 1 ;; esac
  case $1 in *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;; esac
  [ "${#1}" -le 24 ]
}

# A shell is sh-N.
valid_shell() {
  case $1 in sh-[123456789] | sh-[123456789][0123456789] | sh-[123456789][0123456789][0123456789]) ;; *) return 1 ;; esac
}

# alive NAME [DIR VAR]: prints the pid of NAME while its process runs with VAR=NAME (LEA_AGENT,
# pid files in $dir by default); a pid file left by an ended process may point at a reused pid,
# which is not it.
alive() {
  d=${2:-$dir}
  v=${3:-LEA_AGENT}
  [ -f "$d/$1.pid" ] || return 1
  p=$(head -c 16 "$d/$1.pid" | tr -cd 0-9)
  if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then return 1; fi
  tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | grep -qx "$v=$1" || return 1
  printf '%s\n' "$p"
}

# window NAME: the CPU window of agent NAME (#132), LEA_AGENT_CPUS CPUs (4; 0: none) of those lea
# runs on, the ones fewest live agents' windows hold; nothing when the window would hold them all.
# Tools that size themselves from the CPUs they may use (nproc, Go, PHPStan, pytest-xdist...) see
# it, in the agent and in its nested containers (lea-crun).
window() {
  n=${LEA_AGENT_CPUS:-4}
  case $n in '' | *[!0-9]*) n=4 ;; esac
  [ "$n" -gt 0 ] || return 0
  all=${LEA_AGENT_CPU_LIST:-$(awk '/^Cpus_allowed_list:/ { print $2 }' /proc/self/status)}
  for f in "$dir"/*.cpus; do
    [ -f "$f" ] || continue
    a=${f##*/}; a=${a%.cpus}
    if [ "$a" != "$1" ] && valid "$a" && alive "$a" >/dev/null; then head -c 4096 "$f"; echo; fi
  done | awk -v all="$all" -v n="$n" '
    # expand LIST: the CPUs of a list such as 0-3,8 into cpus[1..k]; returns k.
    function expand(list, cpus,   k, i, parts, r, c) {
      k = 0
      split(list, parts, ",")
      for (i in parts) if (parts[i] ~ /^[0-9]+(-[0-9]+)?$/) {
        split(parts[i], r, "-"); if (r[2] == "") r[2] = r[1]
        for (c = r[1] + 0; c <= r[2] + 0 && k < 4096; c++) cpus[++k] = c
      }
      return k
    }
    { m = expand($0, used); for (i = 1; i <= m; i++) load[used[i]]++; delete used }
    END {
      total = expand(all, cpu)
      if (n >= total) exit
      for (j = 1; j <= n; j++) {
        best = 0
        for (i = 1; i <= total; i++) if (!(i in taken) && (best == 0 || load[cpu[i]] + 0 < load[cpu[best]] + 0)) best = i
        taken[best] = 1
      }
      out = ""
      for (i = 1; i <= total; i++) if (i in taken) out = out (out == "" ? "" : ",") cpu[i]
      print out
    }'
}

# tree PID: PID and its descendants, parents first.
tree() {
  todo=$1
  while [ -n "$todo" ]; do
    # shellcheck disable=SC2086 # pids, split on purpose
    set -- $todo
    [ $# -gt 0 ] || break
    p=$1; shift; todo=$*
    printf '%s\n' "$p"
    todo="$todo $(cat /proc/"$p"/task/*/children 2>/dev/null || true)"
  done
}

# freeze PID SIG: SIG to PID's tree, the parent first, so that it starts no new child meanwhile.
freeze() {
  for p in $(tree "$1"); do kill -"$2" "$p" 2>/dev/null || true; done
}

# end PID: TERM, the wait, then KILL. A paused agent and its children continue first: a frozen
# process handles no TERM, and a frozen child would outlive its parent.
end() {
  freeze "$1" CONT
  kill -TERM "$1" 2>/dev/null || true
  i=0
  while kill -0 "$1" 2>/dev/null && [ "$i" -lt $((wait_s * 10)) ]; do sleep 0.1; i=$((i + 1)); done
  kill -KILL "$1" 2>/dev/null || true
}

# service_pid NAME: prints the pid of NAME's own Podman service while it runs (a pid file left by
# an ended service may point at a reused pid, which is not it).
service_pid() {
  [ -f "$dir/$1.podman.pid" ] || return 1
  p=$(head -c 16 "$dir/$1.podman.pid" | tr -cd 0-9)
  if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then return 1; fi
  tr '\0' '\n' <"/proc/$p/cmdline" 2>/dev/null | grep -qxF "unix://$podman_dir/agent-$1.sock" || return 1
  printf '%s\n' "$p"
}

stop_service() {
  if p=$(service_pid "$1"); then end "$p"; fi
  rm -f "$dir/$1.podman.pid" "$podman_dir/agent-$1.sock"
}

# start_service NAME: NAME's own Podman service, with the annotation lea.agent=NAME on every
# container it creates; DOCKER_HOST (docker, docker compose) goes to it and podman itself reads
# the same annotation (CONTAINERS_CONF_OVERRIDE). The service is not the agent's child (pause
# never freezes it). Without it the agent keeps the shared service, with a warning.
start_service() {
  command -v "$podman" >/dev/null 2>&1 || return 0
  conf=$dir/$1.containers.conf
  sock=$podman_dir/agent-$1.sock
  stop_service "$1"
  printf '[containers]\nannotations = ["lea.agent=%s"]\n' "$1" >"$conf"
  CONTAINERS_CONF_OVERRIDE=$conf
  export CONTAINERS_CONF_OVERRIDE
  mkdir -p "$podman_dir"
  (setsid "$podman" system service --time=0 "unix://$sock" </dev/null >/dev/null 2>&1 & echo "$!" >"$dir/$1.podman.pid")
  i=0
  while [ ! -S "$sock" ]; do
    i=$((i + 1))
    if [ "$i" -gt 100 ]; then
      echo "lea-agent: warning: the Podman service of $1 did not start; what it runs with docker is not removed when it ends" >&2
      return 0
    fi
    sleep 0.1
  done
  DOCKER_HOST=unix://$sock
  export DOCKER_HOST
}

# inventory: "id|pod|agent|infra" for each container of the nested Podman (agent: its lea.agent
# annotation, empty when no agent started it; infra: true for a pod's infra container).
inventory() {
  command -v "$podman" >/dev/null 2>&1 || return 0
  ids=$("$podman" ps -aq --no-trunc 2>/dev/null) || return 0
  [ -n "$ids" ] || return 0
  # shellcheck disable=SC2086 # ids, split on purpose
  "$podman" container inspect --format '{{.ID}}|{{.Pod}}|{{index .Config.Annotations "lea.agent"}}|{{.IsInfra}}' $ids 2>/dev/null || true
}

# remove LINES ALL: removes the containers of LINES (lines of ALL, the inventory) and the pods
# whose containers are all in LINES; a pod that also holds others' containers (a pod made by a
# shell, joined by an agent) stays, with its infra container. Prints "N containers and M pods".
remove() {
  ids=$(printf '%s\n' "$1" | awk -F'|' '$1 != "" && $4 != "true" { print $1 }')
  pods=$({ printf '%s\n' "$1" | sed 's/^/S|/'; printf '%s\n' "$2" | sed 's/^/A|/'; } | awk -F'|' '
    $1 == "S" { mine[$2] = 1; if ($3 != "") pod[$3] = 1; next }
    $3 != "" && !($2 in mine) { other[$3] = 1 }
    END { for (p in pod) if (!(p in other)) print p }' | sort)
  # shellcheck disable=SC2086 # ids, split on purpose
  if [ -n "$pods" ]; then "$podman" pod rm -f $pods >/dev/null 2>&1 || true; fi
  # shellcheck disable=SC2086
  if [ -n "$ids" ]; then "$podman" rm -f -v $ids >/dev/null 2>&1 || true; fi
  nc=$(printf '%s\n' "$ids" | grep -c . || true)
  np=$(printf '%s\n' "$pods" | grep -c . || true)
  printf '%s container%s and %s pod%s' "$nc" "$(plural "$nc")" "$np" "$(plural "$np")"
}

plural() { [ "$1" -eq 1 ] || printf s; }

# rss PID...: the resident memory of the PIDs and their descendants, in kB.
rss() {
  for p in "$@"; do
    [ "$p" -gt 0 ] 2>/dev/null || continue
    for q in $(tree "$p"); do sed -n 's/^VmRSS:[[:space:]]*\([0-9]*\) kB$/\1/p' "/proc/$q/status" 2>/dev/null; done
  done | awk '{ s += $1 } END { print s + 0 }'
}

# ticks PID...: the CPU time (user and system clock ticks) of the PIDs and their descendants.
ticks() {
  for p in "$@"; do
    [ "$p" -gt 0 ] 2>/dev/null || continue
    for q in $(tree "$p"); do sed 's/^.*) //' "/proc/$q/stat" 2>/dev/null; done
  done | awk '{ s += $12 + $13 } END { print s + 0 }'
}

# park_ids LINES ALL: sets ids (the running containers of LINES, lines of ALL, the inventory),
# pods (the pods whose containers are all in LINES) and cpids (the containers' main pids).
park_ids() {
  running=" $("$podman" ps -q --no-trunc 2>/dev/null | tr '\n' ' ')"
  ids=$(printf '%s\n' "$1" | awk -F'|' -v r="$running" '$1 != "" && $4 != "true" && index(r, " " $1 " ") { print $1 }')
  pods=$({ printf '%s\n' "$1" | sed 's/^/S|/'; printf '%s\n' "$2" | sed 's/^/A|/'; } | awk -F'|' '
    $1 == "S" { mine[$2] = 1; if ($3 != "") pod[$3] = 1; next }
    $3 != "" && !($2 in mine) { other[$3] = 1 }
    END { for (p in pod) if (!(p in other)) print p }' | sort)
  cpids=
  # shellcheck disable=SC2086 # ids, split on purpose
  if [ -n "$ids" ]; then cpids=$("$podman" container inspect --format '{{.State.Pid}}' $ids 2>/dev/null || true); fi
}

# halt NAME: stops what park_ids found, records it in $dir/NAME.parked for unpark, and prints
# "N containers and M pods (freed X MiB)".
halt() {
  # shellcheck disable=SC2086 # pids, split on purpose
  kb=$(rss $cpids)
  # shellcheck disable=SC2086 # pods and ids, split on purpose
  if [ -n "$pods" ]; then "$podman" pod stop -t 10 $pods >/dev/null 2>&1 || true; fi
  # shellcheck disable=SC2086
  "$podman" stop -t 10 $ids >/dev/null 2>&1 || true
  mkdir -p "$dir"
  { printf '%s\n' "$pods" | sed '/^$/d; s/^/p /'; printf '%s\n' "$ids" | sed '/^$/d; s/^/c /'; } >"$dir/$1.parked"
  nc=$(printf '%s\n' "$ids" | grep -c . || true)
  np=$(printf '%s\n' "$pods" | grep -c . || true)
  printf '%s container%s and %s pod%s (freed %s MiB)' "$nc" "$(plural "$nc")" "$np" "$(plural "$np")" "$((kb / 1024))"
}

case ${1:-} in
  run)
    name=${2:-}
    valid "$name" || { echo "lea-agent: invalid agent name '$name'" >&2; exit 2; }
    shift 2
    # --cli: the agent's program (claude by default, codex); lea-session knows them.
    cli=claude
    if [ "${1:-}" = --cli ]; then
      case ${2:-} in claude | codex) cli=$2 ;; *) echo "lea-agent: unknown CLI '${2:-}'" >&2; exit 2 ;; esac
      shift 2
    fi
    if [ "${1:-}" = -- ]; then shift; fi
    mkdir -p "$dir"
    printf '%s\n' "$$" >"$dir/$name.pid"
    # Its CPU window (#132): the agent, its tools and its Podman service run there; lea-crun pins
    # its nested containers to it.
    rm -f "$dir/$name.cpus"
    w=$(window "$name")
    if [ -n "$w" ]; then
      printf '%s\n' "$w" >"$dir/$name.cpus"
      taskset -p -c "$w" "$$" >/dev/null 2>&1 || true
    fi
    # LockHTTP: the agent's own proxy password (the daemon passes it); without one it keeps the
    # container's ("shell").
    if [ "${LEA_LOCKHTTP:-0}" = 1 ] && [ -n "${LEA_PROXY_TOKEN:-}" ]; then
      case $LEA_PROXY_TOKEN in *[!0123456789abcdef]*) echo "lea-agent: invalid LEA_PROXY_TOKEN" >&2; exit 2 ;; esac
      HTTP_PROXY=http://$name:$LEA_PROXY_TOKEN@$LEA_PROXY_IP:3130
      HTTPS_PROXY=$HTTP_PROXY http_proxy=$HTTP_PROXY https_proxy=$HTTP_PROXY
      export HTTP_PROXY HTTPS_PROXY http_proxy https_proxy
    fi
    unset LEA_PROXY_TOKEN
    start_service "$name"
    LEA_AGENT=$name
    export LEA_AGENT
    exec lea-session "--$cli" "$@"
    ;;
  windows)
    # windows: "NAME CPUS" for each live agent with a CPU window (lea doctor).
    [ -d "$dir" ] || exit 0
    for f in "$dir"/*.cpus; do
      [ -f "$f" ] || continue
      n=${f##*/}; n=${n%.cpus}
      if valid "$n" && alive "$n" >/dev/null; then printf '%s %s\n' "$n" "$(head -c 4096 "$f" | head -n 1 | tr -cd '0-9,-')"; fi
    done
    ;;
  ls)
    [ -d "$dir" ] || exit 0
    for f in "$dir"/*.pid; do
      [ -f "$f" ] || continue
      n=${f##*/}; n=${n%.pid}
      if valid "$n" && alive "$n" >/dev/null; then printf '%s\n' "$n"; else rm -f "$f"; fi
    done
    ;;
  stop)
    name=${2:-}
    valid "$name" || { echo "lea-agent: invalid agent name '$name'" >&2; exit 2; }
    if p=$(alive "$name"); then end "$p"; fi
    rm -f "$dir/$name.pid"
    ;;
  teardown)
    name=${2:-}
    valid "$name" || { echo "lea-agent: invalid agent name '$name'" >&2; exit 2; }
    stop_service "$name"
    rm -f "$dir/$name.containers.conf" "$dir/$name.parked"
    all=$(inventory)
    own=$(printf '%s\n' "$all" | awk -F'|' -v a="$name" '$3 == a')
    if [ -n "$own" ]; then echo "$name: removed $(remove "$own" "$all")"; fi
    ;;
  park)
    # park NAME: the agent is idle (#132): what it started stops, and stays, for it to start again.
    # A stack still at work (a background job of the agent, more than 5% of a CPU over
    # park_sample seconds) is left running: exit 3.
    name=${2:-}
    valid "$name" || { echo "lea-agent: invalid agent name '$name'" >&2; exit 2; }
    command -v "$podman" >/dev/null 2>&1 || exit 0
    all=$(inventory)
    own=$(printf '%s\n' "$all" | awk -F'|' -v a="$name" '$3 == a')
    [ -n "$own" ] || exit 0
    park_ids "$own" "$all"
    [ -n "$ids" ] || exit 0
    # shellcheck disable=SC2086 # pids, split on purpose
    t0=$(ticks $cpids)
    sleep "$park_sample"
    # shellcheck disable=SC2086
    t1=$(ticks $cpids)
    pct=$(awk -v d="$((t1 - t0))" -v s="$park_sample" -v hz="$(getconf CLK_TCK 2>/dev/null || echo 100)" 'BEGIN { printf "%d", d * 100 / (s * hz) }')
    if [ "$pct" -gt 5 ]; then
      echo "$name: stack busy ($pct% of a CPU), not stopped" >&2
      exit 3
    fi
    echo "$name: stopped $(halt "$name")"
    ;;
  unpark)
    # unpark NAME: starts again what park stopped (a new turn came while it stopped them).
    name=${2:-}
    valid "$name" || { echo "lea-agent: invalid agent name '$name'" >&2; exit 2; }
    f=$dir/$name.parked
    [ -f "$f" ] || exit 0
    pods=$(sed -n 's/^p //p' "$f"); ids=$(sed -n 's/^c //p' "$f")
    rm -f "$f"
    command -v "$podman" >/dev/null 2>&1 || exit 0
    # shellcheck disable=SC2086 # pods and ids, split on purpose
    if [ -n "$pods" ]; then "$podman" pod start $pods >/dev/null 2>&1 || true; fi
    # shellcheck disable=SC2086
    if [ -n "$ids" ]; then "$podman" start $ids >/dev/null 2>&1 || true; fi
    nc=$(printf '%s\n' "$ids" | grep -c . || true)
    np=$(printf '%s\n' "$pods" | grep -c . || true)
    echo "$name: started $nc container$(plural "$nc") and $np pod$(plural "$np") again"
    ;;
  sweep)
    # sweep KEEP...: the stacks and services of every agent but KEEP are removed (a new
    # container: those agents are gone), and the containers no agent started are counted.
    shift
    keep=" "
    for n in "$@"; do
      valid "$n" || { echo "lea-agent: invalid agent name '$n'" >&2; exit 2; }
      keep="$keep$n "
    done
    for f in "$dir"/*.podman.pid; do
      [ -f "$f" ] || continue
      n=${f##*/}; n=${n%.podman.pid}
      case $keep in *" $n "*) ;; *) if valid "$n"; then stop_service "$n"; rm -f "$dir/$n.containers.conf"; fi ;; esac
    done
    all=$(inventory)
    gone=$(printf '%s\n' "$all" | awk -F'|' -v keep="$keep" '$3 != "" && index(keep, " " $3 " ") == 0')
    if [ -n "$gone" ]; then
      who=$(printf '%s\n' "$gone" | cut -d'|' -f3 | sort -u | tr '\n' ' ')
      echo "removed $(remove "$gone" "$all") of ended agents (${who% })"
    fi
    un=$(printf '%s\n' "$all" | awk -F'|' 'NF >= 3 && $3 == "" && $4 != "true"' | grep -c . || true)
    if [ "$un" -gt 0 ]; then
      echo "$un container$(plural "$un") that no agent started (a shell, or an older lea) stay in the nested Podman: podman ps -a lists them, podman pod rm -af and podman rm -af remove them"
    fi
    ;;
  pause | resume)
    # The agent's tree, then the running containers it started in the nested Podman (#132): a
    # paused agent's database or browser holds no CPU either. Podman's own pause needs the cgroup
    # freezer, which the nested Podman has not, so their processes get the signal too.
    name=${2:-}
    valid "$name" || { echo "lea-agent: invalid agent name '$name'" >&2; exit 2; }
    p=$(alive "$name") || { echo "lea-agent: $name is not running" >&2; exit 1; }
    sig=CONT
    [ "$1" = pause ] && sig=STOP
    freeze "$p" "$sig"
    if command -v "$podman" >/dev/null 2>&1; then
      all=$(inventory)
      own=$(printf '%s\n' "$all" | awk -F'|' -v a="$name" '$3 == a')
      if [ -n "$own" ]; then
        park_ids "$own" "$all"
        for c in $cpids; do
          if [ "$c" -gt 0 ] 2>/dev/null; then freeze "$c" "$sig"; fi
        done
      fi
    fi
    ;;
  shell)
    name=${2:-}
    valid_shell "$name" || { echo "lea-agent: invalid shell name '$name'" >&2; exit 2; }
    mkdir -p "$shell_dir"
    printf '%s\n' "$$" >"$shell_dir/$name.pid"
    unset LEA_AGENT
    LEA_SHELL=$name
    export LEA_SHELL
    sh=${LEA_AGENT_SHELL:-$(getent passwd "$(id -u)" | cut -d: -f7)}
    [ -n "$sh" ] && [ -x "$sh" ] || sh=/bin/sh
    exec "$sh" -l
    ;;
  shells)
    [ -d "$shell_dir" ] || exit 0
    for f in "$shell_dir"/*.pid; do
      [ -f "$f" ] || continue
      n=${f##*/}; n=${n%.pid}
      if valid_shell "$n" && alive "$n" "$shell_dir" LEA_SHELL >/dev/null; then printf '%s\n' "$n"; else rm -f "$f"; fi
    done
    ;;
  stop-shell)
    name=${2:-}
    valid_shell "$name" || { echo "lea-agent: invalid shell name '$name'" >&2; exit 2; }
    # HUP first, as when a terminal closes: an interactive shell ignores TERM.
    if p=$(alive "$name" "$shell_dir" LEA_SHELL); then kill -HUP "$p" 2>/dev/null || true; end "$p"; fi
    rm -f "$shell_dir/$name.pid"
    ;;
  *)
    echo "usage: lea-agent run NAME [--cli claude|codex] [-- ARGS...] | ls | windows | stop NAME | teardown NAME | park NAME | unpark NAME | sweep [KEEP...] | pause NAME | resume NAME | shell NAME | shells | stop-shell NAME" >&2
    exit 2
    ;;
esac
